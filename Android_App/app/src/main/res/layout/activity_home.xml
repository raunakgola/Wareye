<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_eye" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.06"
            android:text="@string/wordmark"
            android:textColor="@color/ink"
            android:textSize="20sp" />
    </LinearLayout>

    <!-- ModelChip: 40dp visual inside a 48dp target -->
    <LinearLayout
        android:id="@+id/modelChip"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/pill_lavender"
            android:duplicateParentState="true"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="10dp">

            <View
                android:id="@+id/chipDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/dot" />

            <TextView
                android:id="@+id/chipText"
                style="@style/T.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/on_lavender"
                android:textStyle="normal" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron"
                android:tint="@color/on_lavender" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        style="@style/T.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:accessibilityHeading="true"
        android:text="@string/home_headline" />

    <TextView
        style="@style/T.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/home_body" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Whole ring is the target -->
    <FrameLayout
        android:id="@+id/scanButton"
        android:layout_width="208dp"
        android:layout_height="208dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/scan_halo"
        android:clickable="true"
        android:contentDescription="@string/tap_to_scan"
        android:focusable="true">

        <ImageView
            android:layout_width="152dp"
            android:layout_height="152dp"
            android:layout_gravity="center"
            android:background="@drawable/scan_button"
            android:duplicateParentState="true"
            android:elevation="6dp"
            android:importantForAccessibility="no"
            android:scaleType="center"
            android:src="@drawable/ic_shutter" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="24dp"
        android:fontFamily="sans-serif"
        android:importantForAccessibility="no"
        android:letterSpacing="0.16"
        android:text="@string/tap_to_scan"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
