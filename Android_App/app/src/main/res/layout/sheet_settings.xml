<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/sheet_cream"
        android:clickable="true"
        android:maxWidth="480dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/handle_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical">

            <TextView
                style="@style/T.TitleLarge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/settings" />

            <ImageButton
                android:id="@+id/close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="@drawable/ripple_rect"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="@color/ink" />
        </LinearLayout>

        <TextView
            style="@style/T.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/delegate" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/segCpu"
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:background="@drawable/segment"
                android:clickable="true"
                android:drawableTint="@color/ink"
                android:focusable="true"
                android:gravity="center"
                android:text="CPU"
                android:textColor="@color/segment_text" />

            <TextView
                android:id="@+id/segGpu"
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/segment"
                android:clickable="true"
                android:drawableTint="@color/ink"
                android:focusable="true"
                android:gravity="center"
                android:text="GPU"
                android:textColor="@color/segment_text" />
        </LinearLayout>

        <TextView
            android:id="@+id/delegateHint"
            style="@style/T.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <TextView
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/confSlider"
                android:text="@string/confidence" />

            <TextView
                android:id="@+id/confValue"
                style="@style/T.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/confSlider"
            style="@style/Slider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                style="@style/T.Label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:labelFor="@id/iouSlider"
                android:text="@string/iou" />

            <TextView
                android:id="@+id/iouValue"
                style="@style/T.Mono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/ink" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/iouSlider"
            style="@style/Slider" />

        <LinearLayout
            android:id="@+id/metricsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/ripple_rect"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_metrics" />

                <TextView
                    style="@style/T.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/show_metrics_hint" />
            </LinearLayout>

            <Switch
                android:id="@+id/metricsSwitch"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:clickable="false"
                android:focusable="false"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/reset"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="0.4"
                android:text="@string/reset" />

            <TextView
                android:id="@+id/done"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="0.6"
                android:text="@string/done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
