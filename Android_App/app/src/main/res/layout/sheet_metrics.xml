<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:background="@drawable/sheet_cream"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/handle_dark" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/T.TitleLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/metrics" />

                <TextView
                    android:id="@+id/subtitle"
                    style="@style/T.BodySmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/close"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="-12dp"
                android:background="@drawable/ripple_rect"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close"
                android:tint="@color/ink" />
        </LinearLayout>

        <!-- FPS / TOTAL tiles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:id="@+id/fpsTile"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/box_tile"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/T.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FPS" />

                <TextView
                    android:id="@+id/fps"
                    style="@style/T.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="34sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/totalTile"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/box_tile"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/T.LabelSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total" />

                <TextView
                    android:id="@+id/total"
                    style="@style/T.Mono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/ink"
                    android:textSize="34sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Per-frame stages -->
        <TextView
            style="@style/T.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/per_frame_stages" />

        <LinearLayout
            android:id="@+id/stageBar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/stage_track"
            android:importantForAccessibility="no">

            <View
                android:id="@+id/barPre"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="#B9A3D6" />

            <View
                android:id="@+id/barInfer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/forest" />

            <View
                android:id="@+id/barPost"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/red" />
        </LinearLayout>

        <TextView
            android:id="@+id/stages"
            style="@style/T.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/ink"
            android:textSize="13sp" />

        <!-- Latency sparkline -->
        <TextView
            style="@style/T.LabelSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/latency_last_100" />

        <com.raunak.wareye.SparklineView
            android:id="@+id/sparkline"
            android:layout_width="match_parent"
            android:layout_height="136dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/box_tile"
            android:focusable="true" />

        <!-- P50 / P95 / RAM / FOUND -->
        <LinearLayout
            android:id="@+id/smallTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/copy"
                style="@style/OutlineButton"
                android:layout_width="0dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="0.47"
                android:text="@string/copy_as_text" />

            <TextView
                android:id="@+id/done"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="0.53"
                android:text="@string/done" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
